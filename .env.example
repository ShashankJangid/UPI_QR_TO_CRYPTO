# ==========================================
# UPI QR TO CRYPTO (USDT) CONFIGURATION
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_NETWORK=polygon

# Authentication Secret
JWT_SECRET=super-secret-dev-jwt-key-replace-in-production-123456

# Database Configuration (PostgreSQL URL; falls back to embedded SQLite if empty or unreachable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/upi_crypto_db

# Redis Cache & Message Broker (Falls back to in-memory cache if empty or unreachable)
REDIS_URL=redis://localhost:6379

# On-Ramp Provider Configuration (Onramp.money / Staging or Live)
# Register at https://onramp.money to get live API keys
ONRAMP_ENVIRONMENT=sandbox
ONRAMP_API_KEY=test_api_key_sample
ONRAMP_API_SECRET=test_api_secret_sample
ONRAMP_WEBHOOK_SECRET=test_webhook_secret_sample
ONRAMP_BASE_URL=https://api.onramp.money

# Blockchain Configuration (Polygon RPC for verifying on-chain USDT delivery)
POLYGON_RPC_URL=https://polygon-rpc.com
# Polygon PoS USDT Contract Address (Native official bridged token)
POLYGON_USDT_CONTRACT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# BSC RPC & USDT Contract
BSC_RPC_URL=https://binance.llamarpc.com
BSC_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955

# Merchant Default Fallback Wallet (EVM format)
DEFAULT_MERCHANT_WALLET=0x71C7656EC7ab88b098defB751B7401B5f6d8976F
